# Firebase Client Configuration (Spark Plan - Free)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin (somente no servidor; JSON completo em uma única linha)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id"}
FIREBASE_PROJECT_ID=your-project-id
# Alternativa ao JSON acima: remova FIREBASE_SERVICE_ACCOUNT_KEY e use ADC.
# GOOGLE_APPLICATION_CREDENTIALS=caminho/fora/do/repositorio/credenciais.json
# No runtime hospedado, ADC usa a identidade de serviço do ambiente.

# Opcional: habilite apenas depois de configurar o App Check no Firebase Console.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# MCP privado (opcional). Sem configuração completa, o endpoint retorna 503.
# Origem exata, HTTPS, sem barra final. Não usar NEXT_PUBLIC_ para estes campos.
MCP_ORIGIN=
MCP_ALLOWED_UIDS=
MCP_CLIENT_ID=
# Client Secret opcional para cliente confidencial (client_secret_post).
# Deixe vazio apenas se o cliente OAuth usar PKCE sem segredo (none).
MCP_CLIENT_SECRET=
# Callbacks exatos fornecidos pelo ChatGPT, separados por vírgula; sem curingas.
MCP_REDIRECT_URIS=

# Verificação de preview Vercel: configure somente no ambiente do processo de teste.
# PREVIEW_ORIGIN=https://PROJETO-git-BRANCH-ESCOPO.vercel.app
# PREVIEW_ALLOWED_HOST=PROJETO-git-BRANCH-ESCOPO.vercel.app
# PREVIEW_PROJECT_ID=projeto-firebase-de-teste
# PREVIEW_API_KEY=chave-publica-do-firebase-de-teste
# PREVIEW_TEST_EMAIL=conta-de-teste
# PREVIEW_TEST_PASSWORD=senha-da-conta-de-teste
# VERCEL_AUTOMATION_BYPASS_SECRET=segredo-de-automacao-do-projeto-vercel
