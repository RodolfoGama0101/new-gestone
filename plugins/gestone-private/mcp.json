{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gestone": {
      "type": "streamable-http",
      "url": "https://new-gestone.vercel.app/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "gestone-chatgpt",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "transactions:read",
              "transactions:write"
            ],
            "defaultScopes": [
              "transactions:read",
              "transactions:write"
            ]
          }
        }
      }
    }
  }
}
