rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function isDocumentId(value) {
      return value is string && value.size() > 0 && value.size() <= 1500
        && value.matches('^[^/]+$');
    }

    function isValidTagAt(tags, index) {
      return tags.size() <= index
        || (tags[index] is string && tags[index].size() > 0 && tags[index].size() <= 40);
    }

    function isValidTags(tags) {
      // Rules não oferece laços: todos os índices permitidos precisam ser validados.
      return tags is list && tags.size() <= 20
        && isValidTagAt(tags, 0) && isValidTagAt(tags, 1)
        && isValidTagAt(tags, 2) && isValidTagAt(tags, 3)
        && isValidTagAt(tags, 4) && isValidTagAt(tags, 5)
        && isValidTagAt(tags, 6) && isValidTagAt(tags, 7)
        && isValidTagAt(tags, 8) && isValidTagAt(tags, 9)
        && isValidTagAt(tags, 10) && isValidTagAt(tags, 11)
        && isValidTagAt(tags, 12) && isValidTagAt(tags, 13)
        && isValidTagAt(tags, 14) && isValidTagAt(tags, 15)
        && isValidTagAt(tags, 16) && isValidTagAt(tags, 17)
        && isValidTagAt(tags, 18) && isValidTagAt(tags, 19);
    }

    function hasCompatibleCategory(userId, data) {
      let category = getAfter(/databases/$(database)/documents/users/$(userId)/categories/$(data.categoryId)).data;
      return (category.type == data.type || category.type == 'both')
        && (!category.get('archived', false) || (request.method == 'update'
          && resource.data.categoryId == data.categoryId && resource.data.type == data.type));
    }

    function hasValidCard(userId, data) {
      let cardId = data.get('creditCardId', null);
      return cardId == null || (data.type == 'expense' && isDocumentId(cardId)
        && hasAvailableCard(userId, cardId, data));
    }

    function hasAvailableCard(userId, cardId, data) {
      let card = getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)).data;
      return card is map && ((!card.get('archived', false) && card.get('isActive', false) == true)
        || (request.method == 'update' && resource.data.type == data.type
          && resource.data.get('creditCardId', null) == cardId));
    }

    function isValidTransaction(userId, data) {
      return hasOnlyKeys(data, [
        'type', 'amount', 'description', 'categoryId', 'date', 'tags', 'notes',
        'recurring', 'creditCardId', 'cardClosingDay', 'createdAt', 'updatedAt', 'seriesId', 'occurrenceIndex', 'installmentTotal', 'installmentMonth'
      ]) && isValidTransactionFields(userId, data);
    }

    function isValidTransactionFields(userId, data) {
      return data.type in ['income', 'expense', 'investment']
        && data.amount is int && data.amount > 0 && data.amount <= 9007199254740991
        && data.description is string && data.description.size() >= 3 && data.description.size() <= 200
        && isDocumentId(data.categoryId)
        && data.date is timestamp
        && isValidTags(data.tags)
        && (data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && data.recurring is bool
        && ((data.get('seriesId', null) == null && data.get('occurrenceIndex', null) == null && data.get('installmentTotal', null) == null && data.get('installmentMonth', null) == null) || (isDocumentId(data.seriesId)
          && data.occurrenceIndex is int && data.occurrenceIndex >= 0 && data.occurrenceIndex < 1200
          && ((data.get('installmentTotal', null) == null && data.get('installmentMonth', null) == null) || (data.installmentTotal is int && data.installmentTotal >= 2 && data.installmentTotal <= 120
            && data.installmentMonth is string && data.installmentMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
          && existsAfter(/databases/$(database)/documents/users/$(userId)/transactionSeries/$(data.seriesId))))
        && (data.get('cardClosingDay', null) == null || (data.type == 'expense'
          && data.get('creditCardId', null) != null && data.cardClosingDay is int
          && data.cardClosingDay >= 1 && data.cardClosingDay <= 31))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && hasCompatibleCategory(userId, data)
        && hasValidCard(userId, data);
    }

    function isValidProfile(data) {
      // Nome/e-mail de autenticação continuam no Firebase Auth; não aceitamos claims no perfil.
      return hasOnlyKeys(data, ['displayName', 'createdAt', 'updatedAt'])
        && (data.get('displayName', null) == null || (data.displayName is string
          && data.displayName.size() > 0 && data.displayName.size() <= 50))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return hasOnlyKeys(data, ['name', 'type', 'icon', 'color', 'isDefault', 'archived', 'createdAt', 'updatedAt'])
        && data.get('archived', false) is bool
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.type in ['income', 'expense', 'investment', 'both']
        && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 80
        && data.color is string && data.color.size() > 0 && data.color.size() <= 32
        && data.isDefault is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidCreditCard(data) {
      return hasOnlyKeys(data, [
        'name', 'bankName', 'brand', 'holderName', 'closingDay', 'color', 'isActive',
        'archived', 'createdAt', 'updatedAt', 'dueDay'
      ])
        && data.get('archived', false) is bool
        && (!data.get('archived', false) || data.isActive == false)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 50
        && data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 50
        && data.brand in ['visa', 'mastercard', 'elo', 'other']
        && data.holderName is string && data.holderName.size() >= 2 && data.holderName.size() <= 100
        && (data.get('dueDay', null) == null || (data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31))
        && data.closingDay is int && data.closingDay >= 1 && data.closingDay <= 31
        && data.color is string && data.color.size() > 0 && data.color.size() <= 32
        && data.isActive is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      match /preferences/{preferenceId} {
        allow read: if isOwner(userId) && preferenceId == 'display';
        allow create, update: if isOwner(userId) && preferenceId == 'display'
          && hasOnlyKeys(request.resource.data, ['theme', 'updatedAt'])
          && request.resource.data.theme in ['light', 'dark', 'system']
          && request.resource.data.updatedAt is timestamp;
        allow delete: if false;
      }

      match /budgets/{month} {
        function validMonth() { return month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'); }
        function validAmount(data) {
          return data.amount is int && data.amount > 0 && data.amount <= 9007199254740991
            && data.updatedAt is timestamp;
        }
        allow read, delete: if isOwner(userId) && validMonth();
        allow create, update: if isOwner(userId) && validMonth()
          && hasOnlyKeys(request.resource.data, ['amount', 'updatedAt'])
          && validAmount(request.resource.data);
        match /limits/{categoryId} {
          allow read, delete: if isOwner(userId) && validMonth();
          allow create, update: if isOwner(userId) && validMonth()
            && hasOnlyKeys(request.resource.data, ['name', 'amount', 'updatedAt'])
            && validAmount(request.resource.data)
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
            && get(/databases/$(database)/documents/users/$(userId)/categories/$(categoryId)).data.type in ['expense', 'both']
            && !get(/databases/$(database)/documents/users/$(userId)/categories/$(categoryId)).data.get('archived', false);
        }
      }

      match /transactionSeries/{seriesId} {
        function validSeries(data) {
          return hasOnlyKeys(data, ['type', 'amount', 'description', 'categoryId', 'date', 'tags', 'notes', 'recurring', 'creditCardId', 'cardClosingDay', 'createdAt', 'updatedAt', 'kind', 'count', 'nextIndex', 'endDate', 'cancelledFrom', 'timezoneOffset'])
            && isValidTransactionFields(userId, data)
            && data.kind in ['recurring', 'installment']
            && data.count is int && data.count >= 2 && data.count <= 1200
            && (data.kind == 'recurring' || (data.count <= 120 && data.amount >= data.count && data.type == 'expense' && data.creditCardId != null))
            && data.nextIndex is int && data.nextIndex >= 0 && data.nextIndex <= data.count
            && data.timezoneOffset is int && data.timezoneOffset >= -840 && data.timezoneOffset <= 840
            && (data.endDate == null || (data.endDate is timestamp && data.endDate >= data.date))
            && (data.cancelledFrom == null || data.cancelledFrom is timestamp);
        }
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validSeries(request.resource.data) && request.resource.data.nextIndex == 0 && request.resource.data.cancelledFrom == null;
        // Cancelamento permanece disponível mesmo se a referência ficou indisponível.
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelledFrom', 'updatedAt'])
          && request.resource.data.cancelledFrom is timestamp && request.resource.data.updatedAt is timestamp
          && (resource.data.cancelledFrom == null || request.resource.data.cancelledFrom <= resource.data.cancelledFrom);
        allow update: if isOwner(userId) && validSeries(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextIndex', 'amount', 'description', 'cancelledFrom', 'updatedAt'])
          && (resource.data.kind == 'recurring' || request.resource.data.amount == resource.data.amount)
          && request.resource.data.nextIndex >= resource.data.nextIndex && request.resource.data.nextIndex <= resource.data.nextIndex + 1
          && (resource.data.cancelledFrom == null || request.resource.data.cancelledFrom <= resource.data.cancelledFrom);
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(userId, request.resource.data);
        allow update: if isOwner(userId)
          && isValidTransaction(userId, request.resource.data)
          && (resource.data.get('cardClosingDay', null) == null
            || request.resource.data.get('creditCardId', null) != resource.data.get('creditCardId', null)
            || request.resource.data.type != resource.data.type
            || request.resource.data.get('cardClosingDay', null) == resource.data.cardClosingDay)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('seriesId', null) == resource.data.get('seriesId', null)
          && request.resource.data.get('occurrenceIndex', null) == resource.data.get('occurrenceIndex', null)
          && request.resource.data.get('installmentTotal', null) == resource.data.get('installmentTotal', null)
          && request.resource.data.get('installmentMonth', null) == resource.data.get('installmentMonth', null);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow delete: if false;
        allow create: if isOwner(userId) && isValidCategory(request.resource.data)
          && request.resource.data.get('archived', false) == false;
        allow update: if isOwner(userId)
          && isValidCategory(request.resource.data)
          && request.resource.data.get('archived', false) == resource.data.get('archived', false)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /creditCards/{cardId} {
        match /payments/{month} {
          allow read, delete: if isOwner(userId);
          allow create: if isOwner(userId) && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && exists(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId))
            && hasOnlyKeys(request.resource.data, ['amount', 'paidAt'])
            && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 9007199254740991
            && request.resource.data.paidAt is timestamp;
          allow update: if false;
        }
        allow read: if isOwner(userId);
        allow delete: if false;
        allow create: if isOwner(userId) && isValidCreditCard(request.resource.data)
          && request.resource.data.get('archived', false) == false;
        allow update: if isOwner(userId)
          && isValidCreditCard(request.resource.data)
          && (!resource.data.get('archived', false)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
